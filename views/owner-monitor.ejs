<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head') %></head>
<body data-theme="<%= theme %>">
  <%- include('partials/navbar') %>

  <div style="padding:24px; max-width:1100px; margin:0 auto;">
    <div class="card" style="margin-bottom:20px;">
      <h3 style="margin-top:0;">⚠️ Akun Mencurigakan</h3>
      <div id="suspiciousBox" class="table-wrap"></div>
    </div>

    <div class="card">
      <h3 style="margin-top:0;">📡 Log Aktivitas Login (live, refresh tiap 5 detik)</h3>
      <div id="logsBox" class="table-wrap" style="max-height:500px; overflow-y:auto;"></div>
    </div>
  </div>

  <script>
    async function refreshMonitor() {
      const res = await fetch('/owner/monitor/data');
      const data = await res.json();

      document.getElementById('suspiciousBox').innerHTML = data.suspicious.length
        ? '<table><thead><tr><th>Username</th><th>Role</th><th>Last IP</th><th>Locked IP</th></tr></thead><tbody>' +
          data.suspicious.map(u => `<tr><td>${u.username}</td><td>${u.role}</td><td>${u.lastLoginIp||'-'}</td><td>${u.lockedIp||'-'}</td></tr>`).join('') +
          '</tbody></table>'
        : '<p style="color:var(--text-dim);">Tidak ada aktivitas mencurigakan saat ini ✅</p>';

      document.getElementById('logsBox').innerHTML =
        '<table><thead><tr><th>Waktu</th><th>Username</th><th>IP</th><th>Hasil</th></tr></thead><tbody>' +
        data.logs.map(l => {
          const color = l.result === 'success' ? 'var(--success)' : (l.result === 'ip_mismatch' || l.result === 'locked' ? 'var(--danger)' : 'var(--text-dim)');
          return `<tr><td style="font-size:12px;">${new Date(l.createdAt).toLocaleString('id-ID')}</td><td>${l.username}</td><td style="font-size:12px;">${l.ip}</td><td style="color:${color}; font-weight:700;">${l.result}</td></tr>`;
        }).join('') +
        '</tbody></table>';
    }
    refreshMonitor();
    setInterval(refreshMonitor, 5000);
  </script>
</body>
</html>
